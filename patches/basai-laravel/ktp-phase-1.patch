index 0000000..aa32c0a
--- /dev/null
+++ b/tests/Feature/BasKtpCaptureTest.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Services\Basai\Test\KtpCaptureService;
+use App\Services\Basai\Test\UnavailableKtpOcrService;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Validation\ValidationException;
+use Tests\TestCase;
+
+class BasKtpCaptureTest extends TestCase
+{
+    public function test_it_preserves_the_original_and_records_private_capture_metadata(): void
+    {
+        $disk = Storage::fake('local');
+        $image = imagecreatetruecolor(2, 2);
+        ob_start();
+        imagepng($image);
+        $bytes = ob_get_clean();
+
+        $result = app(KtpCaptureService::class)->saveAndRead(
+            base64_encode($bytes), 31, 42, 53, new UnavailableKtpOcrService
+        );
+
+        $this->assertSame(['status' => 'OCR_UNAVAILABLE', 'fields' => [], 'raw_text' => ''], $result);
+        [$directory] = $disk->directories('ktp-captures');
+        $original = $directory.'/original.png';
+        $metadataPath = $directory.'/capture.json';
+        $this->assertSame($bytes, $disk->get($original));
+        $this->assertSame('private', $disk->getVisibility($original));
+        $this->assertSame('private', $disk->getVisibility($metadataPath));
+        $metadata = json_decode($disk->get($metadataPath), true, flags: JSON_THROW_ON_ERROR);
+        $this->assertSame([31, 42, 53], [$metadata['userid'], $metadata['perkara_id'], $metadata['sidang_id']]);
+    }
+
+    public function test_it_rejects_invalid_and_oversized_payloads_without_storing_them(): void
+    {
+        $disk = Storage::fake('local');
+        $captures = app(KtpCaptureService::class);
+
+        foreach (['***', base64_encode('not an image'), str_repeat('A', 7_000_000)] as $payload) {
+            try {
+                $captures->saveAndRead($payload, 31, null, null, new UnavailableKtpOcrService);
+                $this->fail('The invalid image should be rejected.');
+            } catch (ValidationException $exception) {
+                $this->assertArrayHasKey('ktpImage', $exception->errors());
+            }
+        }
+
+        $this->assertSame([], $disk->allFiles('ktp-captures'));
+    }
+}
