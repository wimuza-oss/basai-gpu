@@ -0,0 +1,298 @@
+<style>
+    [data-ktp-panel] { border: 1px solid #ddd; border-radius: 4px; padding: 16px; margin-bottom: 24px; }
+    [data-ktp-panel] .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px 16px; margin: 12px 0; }
+    [data-ktp-panel] .row > div { width: auto; float: none; padding: 0; min-width: 0; }
+    [data-ktp-panel] label, [data-ktp-panel] input[data-ktp-field] { display: block; width: 100%; box-sizing: border-box; }
+    [data-ktp-panel] [data-warnings] { color: #835313; }
+    [data-ktp-panel] [hidden] { display: none !important; }
+</style>
+
+<div class="panel panel-default" data-ktp-panel data-endpoint="{{ $endpoint ?? route('basai.test.ktp') }}" data-csrf="{{ csrf_token() }}">
+    <div class="panel-heading">
+        <div class="panel-title"><strong>Ambil Data KTP Saksi</strong></div>
+    </div>
+    <div class="panel-body">
+        <div class="form-group">
+            <button type="button" class="btn btn-default" data-ktp-action="openCamera">Buka Kamera</button>
+            <button type="button" class="btn btn-default" data-ktp-action="takePhoto" disabled>Ambil Foto</button>
+            <button type="button" class="btn btn-default" data-ktp-action="chooseFile">Pilih Gambar KTP</button>
+            <input type="file" data-file accept="image/jpeg,image/png" hidden>
+            <video data-camera hidden autoplay muted playsinline aria-label="Pratinjau kamera KTP" style="max-width:100%;display:block"></video>
+            <img data-preview hidden alt="Pratinjau gambar KTP" style="max-width:100%;max-height:240px;display:block">
+        </div>
+
+        <button type="button" class="btn btn-primary" data-ktp-action="save" disabled>Baca KTP</button>
+        <p role="status" data-status style="margin-top:8px"></p>
+        <ul class="text-warning" data-warnings hidden></ul>
+
+        <div class="row">
+            @foreach ([
+                'nik' => 'NIK', 'nama' => 'Nama',
+                'tempat_lahir' => 'Tempat Lahir', 'tanggal_lahir' => 'Tanggal Lahir',
+                'jenis_kelamin' => 'Jenis Kelamin', 'alamat' => 'Alamat',
+                'rt_rw' => 'RT/RW', 'kelurahan_desa' => 'Kelurahan/Desa',
+                'kecamatan' => 'Kecamatan', 'agama' => 'Agama',
+                'status_perkawinan' => 'Status Perkawinan', 'pekerjaan' => 'Pekerjaan',
+                'kewarganegaraan' => 'Kewarganegaraan', 'berlaku_hingga' => 'Berlaku Hingga',
+            ] as $key => $label)
+                <div class="col-sm-6 form-group">
+                    <label for="bas-ktp-{{ $key }}">{{ $label }}</label>
+                    <input id="bas-ktp-{{ $key }}" class="form-control" type="text"
+                        data-ktp-field="{{ $key }}" maxlength="{{ $key === 'nik' ? 16 : 255 }}"
+                        @if ($key === 'nik') inputmode="numeric" @endif autocomplete="off">
+                </div>
+            @endforeach
+        </div>
+        <details>
+            <summary>RAW OCR text</summary>
+            <pre data-raw style="white-space:pre-wrap">Belum ada teks OCR.</pre>
+        </details>
+        <button type="button" class="btn btn-default" disabled style="margin-top:10px">Submit ke SIPP</button>
+    </div>
+</div>
+
+<script>
+    (() => {
+        const panel = document.currentScript.previousElementSibling;
+        const find = selector => panel.querySelector(selector);
+        const refs = {
+            camera: find('[data-camera]'),
+            filePicker: find('[data-file]'),
+            rawOcr: find('details'),
+        };
+        const buttons = Object.fromEntries([...panel.querySelectorAll('[data-ktp-action]')].map(
+            button => [button.dataset.ktpAction, button]
+        ));
+        const state = {
+            stream: null,
+            cameraRequest: 0,
+            openingCamera: false,
+            capturing: false,
+            file: null,
+            preview: '',
+            status: '',
+            rawText: '',
+            warnings: [],
+            busy: false,
+
+            destroy() {
+                this.stopCamera();
+                if (this.preview) URL.revokeObjectURL(this.preview);
+            },
+
+            stopCamera() {
+                this.cameraRequest++;
+                this.openingCamera = false;
+                this.capturing = false;
+                if (this.stream) this.stream.getTracks().forEach(track => track.stop());
+                this.stream = null;
+                if (refs.camera) refs.camera.srcObject = null;
+            },
+
+            async openCamera() {
+                this.stopCamera();
+                const request = this.cameraRequest;
+                this.openingCamera = true;
+                try {
+                    const stream = await navigator.mediaDevices.getUserMedia({
+                        audio: false,
+                        video: {
+                            facingMode: { ideal: 'environment' },
+                            width: { ideal: 2560 },
+                            height: { ideal: 1440 }
+                        }
+                    });
+                    if (this.cameraRequest !== request) {
+                        stream.getTracks().forEach(track => track.stop());
+                        return;
+                    }
+                    this.stream = stream;
+                    refs.camera.srcObject = stream;
+                    const track = stream.getVideoTracks()[0];
+                    try {
+                        if (track?.getCapabilities?.().focusMode?.includes('continuous')) {
+                            await track.applyConstraints({ advanced: [{ focusMode: 'continuous' }] });
+                        }
+                    } catch {
+                        // Gunakan fokus bawaan kamera.
+                    }
+                    if (this.cameraRequest === request) {
+                        this.status = 'Arahkan KTP hingga memenuhi frame, lalu ambil foto saat fokus stabil.';
+                    }
+                } catch {
+                    if (this.cameraRequest === request) this.status = 'Kamera tidak dapat dibuka. Periksa izin kamera atau pilih gambar.';
+                } finally {
+                    if (this.cameraRequest === request) this.openingCamera = false;
+                }
+            },
+
+            chooseFile() {
+                this.stopCamera();
+                refs.filePicker.click();
+            },
+
+            async takePhoto() {
+                const video = refs.camera;
+                const track = this.stream?.getVideoTracks()[0];
+                if (!video.videoWidth || !video.videoHeight || !track) {
+                    this.status = 'Kamera belum siap.';
+                    return;
+                }
+
+                if (this.openingCamera) return;
+                const request = ++this.cameraRequest;
+                this.capturing = true;
+                this.status = 'Mengambil foto KTP…';
+                let blob = null;
+                if (typeof window.ImageCapture === 'function') {
+                    try {
+                        blob = await new window.ImageCapture(track).takePhoto();
+                    } catch {
+                        // Gunakan frame video jika pengambilan foto gagal.
+                    }
+                }
+
+                if (request !== this.cameraRequest) return;
+                if (!blob || !['image/jpeg', 'image/png'].includes(blob.type) || blob.size > 5 * 1024 * 1024) {
+                    const canvas = document.createElement('canvas');
+                    canvas.width = video.videoWidth;
+                    canvas.height = video.videoHeight;
+                    canvas.getContext('2d').drawImage(video, 0, 0);
+                    blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.98));
+                }
+
+                if (request !== this.cameraRequest) return;
+                this.stopCamera();
+                if (!blob) {
+                    this.status = 'Foto tidak dapat diambil.';
+                    return;
+                }
+                const extension = blob.type === 'image/png' ? 'png' : 'jpg';
+                this.selectFile(new File([blob], 'capture-ktp.' + extension, { type: blob.type }));
+            },
+
+            selectFile(file) {
+                if (!file) return;
+                if (this.preview) URL.revokeObjectURL(this.preview);
+                this.preview = '';
+                this.file = null;
+                for (const input of panel.querySelectorAll('[data-ktp-field]')) input.value = '';
+                this.rawText = '';
+                this.warnings = [];
+                refs.rawOcr.open = false;
+                if (!['image/jpeg', 'image/png'].includes(file.type) || file.size > 5 * 1024 * 1024) {
+                    this.status = 'Pilih gambar JPEG atau PNG berukuran maksimal 5 MB.';
+                    return;
+                }
+                this.file = file;
+                this.preview = URL.createObjectURL(file);
+                this.status = 'Gambar siap dibaca.';
+            },
+
+            async save() {
+                if (!this.file || this.busy) return;
+                this.stopCamera();
+                this.busy = true;
+                this.status = 'Membaca gambar KTP…';
+                try {
+                    const encodedImage = await new Promise((resolve, reject) => {
+                        const reader = new FileReader();
+                        reader.onload = () => resolve(reader.result.split(',')[1]);
+                        reader.onerror = () => reject(reader.error);
+                        reader.readAsDataURL(this.file);
+                    });
+                    const response = await fetch(panel.dataset.endpoint, {
+                        method: 'POST',
+                        headers: {
+                            Accept: 'application/json',
+                            'Content-Type': 'application/json',
+                            'X-CSRF-TOKEN': panel.dataset.csrf,
+                        },
+                        body: JSON.stringify({ ktpImage: encodedImage }),
+                    });
+                    if (response.status === 419 || response.redirected) {
+                        this.status = 'Sesi BAS-AI berakhir. Muat ulang halaman dan masuk kembali.';
+                        return;
+                    }
+                    const result = await response.json();
+                    if (!response.ok) {
+                        this.status = result.errors?.ktpImage?.[0] || 'Gambar gagal dikirim. Coba lagi.';
+                        return;
+                    }
+                    this.showResult(result);
+                } catch {
+                    this.status = 'Gambar gagal dikirim. Coba lagi.';
+                } finally {
+                    this.busy = false;
+                }
+            },
+
+            showResult(result) {
+                this.status = {
+                    OCR_UNAVAILABLE: 'OCR belum tersedia (OCR_UNAVAILABLE). Gambar belum disimpan.',
+                    OCR_FAILED: 'OCR gagal dijalankan. Gambar belum disimpan.',
+                    OCR_NO_FIELDS: 'OCR tidak menemukan teks. Gambar belum disimpan.',
+                    OCR_REVIEW_REQUIRED: 'Teks terbaca, tetapi belum dapat dipetakan ke kolom KTP. Periksa teks OCR di bawah. Gambar belum disimpan.',
+                    OCR_REVIEW: 'Gambar tersimpan secara privat. Periksa dan koreksi kolom hasil OCR.',
+                    STORAGE_ERROR: 'Gambar KTP gagal disimpan.',
+                }[result.status] || result.status;
+                if (result.status === 'OCR_REVIEW') this.file = null;
+                for (const input of panel.querySelectorAll('[data-ktp-field]')) {
+                    if (Object.hasOwn(result.fields, input.dataset.ktpField)) input.value = result.fields[input.dataset.ktpField];
+                }
+                this.warnings = result.warnings;
+                this.rawText = result.raw_text;
+                if (result.status === 'OCR_REVIEW_REQUIRED') refs.rawOcr.open = true;
+            },
+        };
+
+        function render() {
+            buttons.openCamera.disabled = state.busy || state.openingCamera || state.capturing;
+            buttons.takePhoto.disabled = state.busy || state.openingCamera || state.capturing || !state.stream;
+            buttons.chooseFile.disabled = state.busy;
+            buttons.save.disabled = state.busy || !state.file;
+            refs.camera.hidden = !state.stream;
+            const preview = find('[data-preview]');
+            if (state.preview) preview.src = state.preview;
+            else preview.removeAttribute('src');
+            preview.hidden = !state.preview;
+            find('[data-status]').textContent = state.status;
+            find('[data-raw]').textContent = state.rawText || 'Belum ada teks OCR.';
+            const warnings = find('[data-warnings]');
+            warnings.replaceChildren(...state.warnings.map(message => {
+                const warning = document.createElement('li');
+                warning.textContent = message;
+                return warning;
+            }));
+            warnings.hidden = !state.warnings.length;
+        }
+
+        for (const [action, button] of Object.entries(buttons)) {
+            button.addEventListener('click', async () => {
+                try {
+                    const task = state[action]();
+                    render();
+                    await task;
+                } catch {
+                    state.stopCamera();
+                    state.status = 'Aksi KTP gagal. Coba lagi.';
+                } finally {
+                    render();
+                }
+            });
+        }
+
+        refs.filePicker.addEventListener('change', () => {
+            state.selectFile(refs.filePicker.files[0]);
+            refs.filePicker.value = '';
+            render();
+        });
+        window.addEventListener('pagehide', () => {
+            state.destroy();
+            state.preview = '';
+            state.file = null;
+            render();
+        });
+        render();
+    })();
+</script>
