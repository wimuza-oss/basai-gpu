+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers\Basai;
+
+use App\Services\Basai\Test\KtpCaptureService;
+use App\Services\Basai\Test\TesseractKtpOcrService;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+final class BasaiTestKtpController
+{
+    public function __invoke(Request $request, KtpCaptureService $captures, TesseractKtpOcrService $ocr): JsonResponse
+    {
+        abort_unless(app()->environment('local'), 404);
+
+        $auth = $request->attributes->get('basai.auth');
+        $userId = filter_var($auth['userid'] ?? null, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
+        abort_if($userId === false, 403);
+
+        $validated = $request->validate(['ktpImage' => ['required', 'string']]);
+
+        // Halaman uji mandiri tidak memilih perkara atau jadwal sidang.
+        $result = $captures->saveAndRead($validated['ktpImage'], $userId, null, null, $ocr);
+
+        return response()->json($result)->header('Cache-Control', 'no-store');
+    }
+}
