@@ -0,0 +1,78 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Basai\Test;
+
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+final class KtpCaptureService
+{
+    public const MAX_BYTES = 5 * 1024 * 1024;
+
+    public function __construct(private KtpImageQuality $quality) {}
+
+    /** @return array{status: string, fields: array<string, string>, raw_text: string, warnings: list<string>} */
+    public function saveAndRead(string $encodedImage, int $userId, ?int $caseId, ?int $hearingId, KtpOcrService $ocr): array
+    {
+        $maxEncodedBytes = 4 * intdiv(self::MAX_BYTES + 2, 3);
+        $image = strlen($encodedImage) <= $maxEncodedBytes ? base64_decode($encodedImage, true) : false;
+
+        if (! is_string($image) || $image === '' || strlen($image) > self::MAX_BYTES) {
+            throw ValidationException::withMessages(['ktpImage' => 'Pilih gambar KTP berukuran maksimal 5 MB.']);
+        }
+
+        $mime = (new \finfo(FILEINFO_MIME_TYPE))->buffer($image);
+        $info = @getimagesizefromstring($image);
+        $extension = match ($mime) {
+            'image/jpeg' => 'jpg',
+            'image/png' => 'png',
+            default => null,
+        };
+
+        if ($extension === null || ! $info || $info['mime'] !== $mime
+            || $info[0] * $info[1] > 16_000_000
+            || ($decoded = @imagecreatefromstring($image)) === false) {
+            throw ValidationException::withMessages(['ktpImage' => 'Gunakan gambar JPEG atau PNG yang valid, maksimal 16 megapiksel.']);
+        }
+
+        $warnings = $this->quality->warnings($decoded);
+        unset($decoded);
+
+        $result = $ocr->read($image, $mime);
+        $result['warnings'] = $warnings;
+        if ($result['status'] !== 'OCR_REVIEW' || $result['fields'] === []) {
+            return $result;
+        }
+
+        $disk = Storage::disk('local');
+        $directory = 'ktp-captures/'.Str::uuid();
+        $original = "original.{$extension}";
+        $metadata = json_encode([
+            'userid' => $userId,
+            'perkara_id' => $caseId,
+            'sidang_id' => $hearingId,
+            'original' => $original,
+            'mime' => $mime,
+            'bytes' => strlen($image),
+            'captured_at' => now()->toIso8601String(),
+        ], JSON_THROW_ON_ERROR);
+
+        try {
+            $saved = $disk->put("{$directory}/{$original}", $image, 'private')
+                && $disk->put("{$directory}/capture.json", $metadata, 'private');
+        } catch (\Throwable) {
+            $saved = false;
+        }
+
+        if (! $saved) {
+            $disk->deleteDirectory($directory);
+
+            return array_replace($result, ['status' => 'STORAGE_ERROR']);
+        }
+
+        return $result;
+    }
+}
diff --git a/app/Services/Basai/Test/KtpImageQuality.php b/app/Services/Basai/Test/KtpImageQuality.php
new file mode 100644
index 0000000..ddd78c4
--- /dev/null
+++ b/app/Services/Basai/Test/KtpImageQuality.php
@@ -0,0 +1,76 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Basai\Test;
+
+use GdImage;
+
+final class KtpImageQuality
+{
+    /** @return list<string> */
+    public function warnings(GdImage $image): array
+    {
+        $width = imagesx($image);
+        $height = imagesy($image);
+        $warnings = [];
+
+        if (max($width, $height) < 1000 || min($width, $height) < 600) {
+            $warnings[] = 'Resolusi foto rendah. Disarankan ambil ulang dari jarak lebih dekat.';
+        }
+
+        $scale = min(1, 320 / max($width, $height));
+        $sampleWidth = max(1, (int) round($width * $scale));
+        $sampleHeight = max(1, (int) round($height * $scale));
+        $sample = imagecreatetruecolor($sampleWidth, $sampleHeight);
+        if ($sample === false) {
+            return $warnings;
+        }
+
+        imagefill($sample, 0, 0, 0xffffff);
+        imagecopyresampled($sample, $image, 0, 0, 0, 0, $sampleWidth, $sampleHeight, $width, $height);
+
+        $luminance = [];
+        $sum = $sumSquares = 0.0;
+        for ($y = 0; $y < $sampleHeight; $y++) {
+            for ($x = 0; $x < $sampleWidth; $x++) {
+                $rgb = imagecolorat($sample, $x, $y);
+                $level = 0.2126 * (($rgb >> 16) & 255) + 0.7152 * (($rgb >> 8) & 255) + 0.0722 * ($rgb & 255);
+                $luminance[] = $level;
+                $sum += $level;
+                $sumSquares += $level * $level;
+            }
+        }
+        unset($sample);
+
+        $count = count($luminance);
+        $brightness = $sum / $count;
+        $contrastVariance = $sumSquares / $count - $brightness ** 2;
+        if ($brightness < 55 || $brightness > 235) {
+            $warnings[] = 'Foto terlalu gelap atau terlalu terang. Sesuaikan pencahayaan.';
+        }
+        if ($contrastVariance < 24 ** 2) {
+            $warnings[] = 'Kontras foto rendah. Hindari pantulan cahaya dan bayangan.';
+        }
+
+        // Varians Laplacian pada sampel berukuran tetap memberikan estimasi ketajaman.
+        $edgeSum = $edgeSquares = 0.0;
+        $edgeCount = 0;
+        for ($y = 1; $y < $sampleHeight - 1; $y++) {
+            for ($x = 1; $x < $sampleWidth - 1; $x++) {
+                $i = $y * $sampleWidth + $x;
+                $edge = 4 * $luminance[$i] - $luminance[$i - 1] - $luminance[$i + 1]
+                    - $luminance[$i - $sampleWidth] - $luminance[$i + $sampleWidth];
+                $edgeSum += $edge;
+                $edgeSquares += $edge * $edge;
+                $edgeCount++;
+            }
+        }
+
+        if ($edgeCount > 0 && $edgeSquares / $edgeCount - ($edgeSum / $edgeCount) ** 2 < 75) {
+            $warnings[] = 'Foto kurang tajam, OCR mungkin tidak akurat. Disarankan ambil ulang.';
+        }
+
+        return $warnings;
+    }
+}
